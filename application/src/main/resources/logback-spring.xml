<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback configuration — adds a dedicated rolling appender for enterprise
  data logs (infrastructure.enterprise package). All other logging continues
  through the Spring Boot default console appender.

  @author  Bill Blackmon
  @since   2026-09-08
-->
<configuration>

    <!-- Include Spring Boot defaults so we get the standard console appender -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- Enterprise data rolling file appender -->
    <appender name="ENTERPRISE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/enterprise-data.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/enterprise-data.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Enterprise package writes to its own file, not to console -->
    <logger name="com.wgblackmon.aihealthcare.infrastructure.enterprise"
            level="DEBUG" additivity="false">
        <appender-ref ref="ENTERPRISE_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
